# ChurnGuard Backend Environment Variables
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
DATABASE_URL=sqlite:///./churnguard.db

# Supabase Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Restrict authentication to approved company email domain (e.g., yourcompany.com)
# Leave empty to allow any domain, provided the user exists in public.authorized_members.
ALLOWED_COMPANY_DOMAIN=
